<?xml version="1.0" ?>
<!--
  Land, ramp and pool for the AmphiBot example (MIT, see LICENSE).
  Land top at z = 0.05, a 7.8 degree ramp down to the pool floor at
  z = -0.6. The water surface is z = 0 (arena_config.yaml, water.height).
-->
<sdf version="1.6">
  <world name="world">
    <model name="arena_ramp">
      <pose>0 0 0 0 0 0</pose>
      <link name="land">
        <pose>-2 0 0 0 0 0</pose>
        <collision name="land_collision">
          <geometry><box><size>4 6 0.1</size></box></geometry>
        </collision>
        <visual name="land_visual">
          <geometry><box><size>4 6 0.1</size></box></geometry>
          <material>
            <ambient>0.55 0.45 0.3 1</ambient>
            <diffuse>0.6 0.5 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="ramp">
        <pose>1.993 0 -0.2995 0 0.1365 0</pose>
        <collision name="ramp_collision">
          <geometry><box><size>4.04 6 0.1</size></box></geometry>
        </collision>
        <visual name="ramp_visual">
          <geometry><box><size>4.04 6 0.1</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.4 1</ambient>
            <diffuse>0.7 0.65 0.45 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="pool_floor">
        <pose>8 0 -0.65 0 0 0</pose>
        <collision name="pool_floor_collision">
          <geometry><box><size>8 6 0.1</size></box></geometry>
        </collision>
        <visual name="pool_floor_visual">
          <geometry><box><size>8 6 0.1</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.35 1</ambient>
            <diffuse>0.45 0.45 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
