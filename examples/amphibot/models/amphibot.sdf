    <!-- Publishes the model pose so the gait script can tell land from water -->
    <!--
      Passive wheels: one free-rolling wheel under each link, as on the
      real AmphiBot I. They roll along the body and grip sideways, which
      gives the body the anisotropic friction it needs to crawl on land.
    -->
    <link name="head_wheel">
      <pose>0.000 0 -0.012 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>5.0000e-07</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.5000e-07</iyy><iyz>0</iyz>
          <izz>5.0000e-07</izz>
        </inertia>
      </inertial>
      <collision name="head_wheel_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.03</length></cylinder></geometry>
      </collision>
      <visual name="head_wheel_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
