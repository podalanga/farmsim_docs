<?xml version="1.0"?>
<!--
  AmphiBot-style amphibious snake robot (primitive shapes only)
  Inspired by AmphiBot I (Crespi, Ijspeert et al., EPFL BioRob, 2005).
  Head + 7 body segments, 7 yaw joints, ~0.56 m long.
  License: MIT (see LICENSE).

  Ported to FARMS from the Gazebo Harmonic version: the gz plugins
  (joint position controllers, hydrodynamics) are removed, FARMS provides
  the motors (animat_config.yaml) and the water forces (arena_config.yaml).
  The anisotropic friction below (mu2, fdir1) is Gazebo-specific and
  ignored by FARMS.
-->
<sdf version="1.9">
  <model name="amphibot">

    <link name="head">
      <pose>0.000 0 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>2.7083e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5.1042e-05</iyy><iyz>0</iyz>
          <izz>5.7708e-05</izz>
        </inertia>
      </inertial>
      <collision name="head_collision">
        <geometry><box><size>0.068 0.045 0.035</size></box></geometry>
        <surface>
          <friction>
            <!-- Anisotropic friction (like a snake's belly scales):
                 low along the body axis (fdir1 = x), high sideways (mu2). -->
            <ode><mu>0.15</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1></ode>
          </friction>
        </surface>
      </collision>
      <visual name="head_visual">
        <geometry><box><size>0.066 0.045 0.035</size></box></geometry>
        <material><ambient>0.1 0.45 0.3 1</ambient><diffuse>0.1 0.45 0.3 1</diffuse></material>
      </visual>
      <visual name="head_nose">
        <pose>0.033 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.0225</radius></sphere></geometry>
        <material><ambient>0.95 0.75 0.1 1</ambient><diffuse>0.95 0.75 0.1 1</diffuse></material>
      </visual>
      <visual name="head_eye_left">
        <pose>0.03 0.016 0.014 0 0 0</pose>
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="head_eye_right">
        <pose>0.03 -0.016 0.014 0 0 0</pose>
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="seg1">
      <pose>-0.070 0 0 0 0 0</pose>
      <inertial>
        <mass>0.09</mass>
        <inertia>
          <ixx>2.4375e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.5938e-05</iyy><iyz>0</iyz>
          <izz>5.1938e-05</izz>
        </inertia>
      </inertial>
      <collision name="seg1_collision">
        <geometry><box><size>0.068 0.045 0.035</size></box></geometry>
        <surface>
          <friction>
            <!-- Anisotropic friction (like a snake's belly scales):
                 low along the body axis (fdir1 = x), high sideways (mu2). -->
            <ode><mu>0.15</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1></ode>
          </friction>
        </surface>
      </collision>
      <visual name="seg1_visual">
        <geometry><box><size>0.066 0.045 0.035</size></box></geometry>
        <material><ambient>0.95 0.75 0.1 1</ambient><diffuse>0.95 0.75 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="joint1" type="revolute">
      <parent>head</parent>
      <child>seg1</child>
      <pose>0.035 0 0 0 0 0</pose>  <!-- front face of the child segment -->
      <axis>
        <xyz>0 0 1</xyz>  <!-- yaw joint: horizontal undulation -->
        <limit><lower>-1.0</lower><upper>1.0</upper><effort>2.0</effort><velocity>6.0</velocity></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <link name="seg2">
